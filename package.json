{
  "name": "gated-github-mcp",
  "version": "0.1.0",
  "description": "MCP server for GitHub, gated by a policy file and recorded in a tamper-evident audit log",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gated-github-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "verify-log": "echo 'verify-log: implemented in Phase 3' && exit 1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@octokit/rest": "^22.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
