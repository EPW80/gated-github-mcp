# Fine-grained token scoped to ONE sandbox repo: Issues RW, Pull requests RW, Commit statuses R, Checks R.
# Do NOT grant Contents: write (required to merge), so the token cannot merge even if the policy changes.
GITHUB_TOKEN=
POLICY_PATH=./policy.yaml
AUDIT_LOG_PATH=./audit.jsonl
# Optional: one OpenTelemetry span per tool call, as JSON on stderr
# OTEL_TRACES_EXPORTER=console
